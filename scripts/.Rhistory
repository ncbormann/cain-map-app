select(date, country_coded, town_ln, town_lat, actor_a, actor_b, actor_group_a_reduced, actor_group_b_reduced, deaths) %>%
group_by(town_lat, town_ln) %>%
mutate(
n_points = n(),
angle = (row_number() - 1) * (2 * pi / n_points),
lat_new = if_else(n_points > 1, town_lat + radius * cos(angle), town_lat),
lon_new = if_else(n_points > 1, town_ln + radius * sin(angle), town_ln),
) %>%
ungroup() %>%
mutate(index = row_number()) %>%
select(-angle, -n_points)
all_events_filtered %>% filter(country_coded == "Czechoslovakia", actor_b_group == "Ethnic Minority")
glimpse(all_events_filtered)
all_events_filtered %>% filter(country_coded == "Czechoslovakia", actor_group_a_reduced == "Ethnic Minority")
view(all_events_filtered %>% filter(country_coded == "Czechoslovakia", actor_group_a_reduced == "Ethnic Minority"))
country_bounds <- all_events_filtered %>%
group_by(country_coded) %>%
summarise(
min_lon = min(lon_new),
max_lon = max(lon_new),
min_lat = min(lat_new),
max_lat = max(lat_new),
center_lon = (min_lon + max_lon) / 2,
center_lat = (min_lat + max_lat) / 2
) %>%
ungroup()
View(country_bounds)
pacman::p_load(tidyverse, geojsonsf, stringr, lubridate, jsonlite)
write_json(country_bounds, "italy_app/src/lib/data/country_bounds.json", pretty = TRUE)
