# Use destPoint to calculate new coordinates based on bearing and distance
new_coords = if_else(n_points > 1,
map2(town_ln, town_lat, ~destPoint(c(.x, .y),
bearing = angle * 180/pi,
distance = radius)),
map2(town_ln, town_lat, ~c(.x, .y)))
) %>%
ungroup() %>%
mutate(
lon_new = map_dbl(new_coords, 1),
lat_new = map_dbl(new_coords, 2)
) %>%
select(-new_coords, -angle, -n_points) %>%
mutate(index = row_number())
