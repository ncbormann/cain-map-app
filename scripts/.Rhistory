mutate(
n_points = n(),
bearing = (row_number() - 1) * (360 / n_points),  # Bearing in degrees (0-360)
# Calculate new coordinates using destPoint
new_point = if_else(n_points > 1,
destPoint(cbind(town_ln, town_lat), bearing = bearing, d = radius),
cbind(town_ln, town_lat))
) %>%
ungroup() %>%
mutate(
lon_new = new_point[,1],
lat_new = new_point[,2]
) %>%
select(-new_point, -bearing, -n_points) %>%
mutate(index = row_number())
