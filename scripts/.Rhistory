!is.na(town_lat),
!is.na(date)) %>%
select(date, country, town_ln, town_lat, actor_a, actor_b, actor_group_a_reduced, actor_group_b_reduced, deaths) %>%
group_by(town_lat, town_ln) %>%
mutate(
n_points = n(),
bearing = (row_number() - 1) * (360 / n_points),  # Bearing in degrees (0-360)
# Calculate new coordinates using destPoint
new_point = if_else(n_points > 1,
destPoint(cbind(town_ln, town_lat), bearing = bearing, d = radius),
cbind(town_ln, town_lat))
) %>%
ungroup() %>%
mutate(
lon_new = new_point[,1],
lat_new = new_point[,2]
) %>%
select(-new_point, -bearing, -n_points) %>%
mutate(index = row_number())
all_events_filtered <- europe %>%
left_join(actors, by = c("actor_a_group" = "original_actor")) %>%
rename(actor_group_a_reduced = primary_category) %>%
left_join(actors, by = c("actor_b_group" = "original_actor")) %>%
rename(actor_group_b_reduced = primary_category) %>%
filter(!is.na(town_ln),
!is.na(town_lat),
!is.na(date)) %>%
select(date, country, town_ln, town_lat, actor_a, actor_b, actor_group_a_reduced, actor_group_b_reduced, deaths) %>%
group_by(town_lat, town_ln) %>%
mutate(
n_points = n(),
bearing = (row_number() - 1) * (360 / n_points)
) %>%
rowwise() %>%  # Process each row individually
mutate(
new_coords = if(n_points > 1) {
# destPoint expects: p (matrix or vector), bearing, d (distance in meters)
destPoint(c(town_ln, town_lat), bearing = bearing, d = radius)
} else {
c(town_ln, town_lat)
},
lon_new = new_coords[1],
lat_new = new_coords[2]
) %>%
ungroup() %>%
select(-new_coords, -bearing, -n_points) %>%
mutate(index = row_number())
glimpse(all_events_filtered)
write_csv(article_text, "italy_app/src/lib/data/lorum_ipsum.csv")
write_file(article_text, "italy_app/src/lib/data/lorum_ipsum.json", pretty = FALSE, auto_unbox = TRUE)
